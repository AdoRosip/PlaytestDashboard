# Placeholder template only. Local .env.local or Vercel Preview (QA).
# Main guide: portal-api.md. Never commit real credentials or use NEXT_PUBLIC_.
PORTAL_MODE=true
PLAYLYTIX_API_BASE_URL=https://qa.playlytix.gg/api
DASHBOARD_SSO_SECRET=<QA shared Portal signing secret>
DASHBOARD_SESSION_SECRET=<independent random QA dashboard-only secret>
PORTAL_DEBUG=false
PLAYLYTIX_TEST_GAME_MAP={}

# Historical QA clients: 18 owns test 32; 2 owns test 28. Confirm current assignment.
# Values are finished client-scoped API keys, never the backend master key.
# Paste JSON directly into Vercel without outer shell quotes.
PLAYLYTIX_CLIENT_KEYS={"18":"<supplied QA API key for client 18>","2":"<supplied QA API key for client 2>"}
