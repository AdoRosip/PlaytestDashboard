# Placeholder template only. Set these in Vercel's Production environment.
# Main guide: portal-api.md (includes exact clientApiKey derivation).
# Do not commit real credentials. No variable uses NEXT_PUBLIC_.
PORTAL_MODE=true
PLAYLYTIX_API_BASE_URL=https://app.playlytix.gg/api
DASHBOARD_SSO_SECRET=<production shared Portal signing secret>
DASHBOARD_SESSION_SECRET=<independent random dashboard-only secret>
PORTAL_DEBUG=false
PLAYLYTIX_TEST_GAME_MAP={}

# Client IDs are NOT TestIDs. Each key must be scoped to its client upstream.
# Derive values locally from production master key + actual developer user ID.
# The dashboard does not need the master key in Vercel. Never put it in this map.
# IDs below are illustrative, not confirmed production assignments.
# Paste the JSON object directly into Vercel without outer shell quotes.
PLAYLYTIX_CLIENT_KEYS={"7":"<production API key for client 7>","9":"<production API key for client 9>"}
